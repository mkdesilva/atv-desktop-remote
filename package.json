{
    "name": "atv-mac-remote",
    "version": "2.3.0",
    "main": "app/main.js",
    "description": "ATV Remote",
    "productName": "ATV Remote",
    "build": {
        "productName": "ATV Remote",
        "appId": "com.mkdesilva.atvremote",
        "mac": {
            "category": "public.app-category.utilities",
            "identity": "Mihindu Kirahandi de Silva (4TFEU94KP6)",
            "notarize": true,
            "extendInfo": {
                "NSLocalNetworkUsageDescription": "ATV Remote finds and controls Apple TVs on your local network.",
                "NSBonjourServices": [
                    "_airplay._tcp",
                    "_companion-link._tcp",
                    "_device-info._tcp"
                ]
            },
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist"
        }
    },
    "scripts": {
        "start": "electron app",
        "postinstall": "electron-builder install-app-deps",
        "fullclean": "npx rimraf node_modules app/node_modules dist",
        "clean": "npx rimraf node_modules app/node_modules",
        "reset": "npm run clean && npm install --legacy-peer-deps",
        "build": "npx electron-builder -m",
        "docker-build": "./electron_docker.sh 'npm run build:win'",
        "build:win": "npx electron-builder -w",
        "build-arm": "npx electron-builder -m --arm64",
        "release": "npx electron-builder -m --x64 --arm64 && gh release create v$npm_package_version dist/*-$npm_package_version*.dmg dist/*-$npm_package_version*-mac.zip --target $(git rev-parse HEAD) --title v$npm_package_version --generate-notes"
    },
    "devDependencies": {
        "electron": "^41.1.0",
        "electron-builder": "^26.8.2",
        "rimraf": "^6.1.2"
    },
    "dependencies": {
        "@electron/remote": "^2.1.2",
        "menubar": "^9.5.1"
    }
}